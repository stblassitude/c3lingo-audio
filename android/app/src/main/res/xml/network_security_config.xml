<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds only talk https. The debug build allows plain http for test servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Let's Encrypt's root, which Android only ships from 7.1.1 on. -->
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
