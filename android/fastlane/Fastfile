# Lanes for Google Play. See "Releasing the Android app" and "Screenshots" in README.md.
#
# The store listing comes from metadata/android/<language>/: title, short and full
# description, icon, feature graphic, screenshots, and the release notes in
# changelogs/<version code>.txt. F-Droid reads the same files.

PACKAGE_NAME = "org.c3lingo.audio"

# Absolute, as actions run in android/, not in fastlane/ like the lanes.
METADATA_PATH = File.expand_path("metadata/android", __dir__)

GRADLE = File.expand_path("../app/build.gradle.kts", __dir__)

# Uploads the store listing, without a build, with the service account key in the file
# GOOGLE_PLAY_JSON_KEY_PATH. For changes between releases; each release uploads it too.
#
#   bundle exec fastlane upload_listing
lane :upload_listing do
  upload_to_play_store(
    package_name: PACKAGE_NAME,
    json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH"),
    metadata_path: METADATA_PATH,
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_changelogs: true,
    # Only the images that changed.
    sync_image_upload: true
  )
end

# Uploads an app bundle to the internal testing track, with its release notes and the
# store listing. Called by .github/workflows/android-release.yml with the key itself in
# GOOGLE_PLAY_JSON_KEY.
#
#   bundle exec fastlane upload_internal aab:/path/to/app-release.aab
lane :upload_internal do |options|
  # Languages without release notes get the English ones, as in the App Store. This
  # changes the checkout, which is the workflow's own.
  code = File.read(GRADLE)[/^ *versionCode = (\d+)$/, 1] || UI.user_error!("No versionCode in #{GRADLE}")
  english = File.join(METADATA_PATH, "en-US", "changelogs", "#{code}.txt")
  Dir.children(METADATA_PATH).each do |language|
    notes = File.join(METADATA_PATH, language, "changelogs", "#{code}.txt")
    next if File.exist?(notes)
    FileUtils.mkdir_p(File.dirname(notes))
    FileUtils.cp(english, notes)
  end

  upload_to_play_store(
    package_name: PACKAGE_NAME,
    json_key_data: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
    track: "internal",
    aab: options.fetch(:aab),
    metadata_path: METADATA_PATH,
    skip_upload_apk: true,
    sync_image_upload: true
  )
end
