    "Nothing is being broadcast on this channel right now. It starts playing as soon as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Kanal wird gerade nichts übertragen. Die Wiedergabe startet, sobald es losgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se emite nada en este canal. Empezará a sonar en cuanto haya emisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est diffusé sur ce canal pour le moment. La lecture démarre dès que la diffusion commence."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym kanale nic teraz nie jest nadawane. Odtwarzanie rozpocznie się, gdy tylko ruszy transmisja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não está a ser emitido nada neste canal. A reprodução começa assim que houver emissão."
          }
        }
      }
    },
