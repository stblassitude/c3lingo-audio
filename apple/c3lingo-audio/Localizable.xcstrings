    "Can't connect. Make sure you are on the event Wi-Fi. Retrying…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Prüfe, ob du im Event-WLAN bist. Neuer Versuch…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar. Comprueba que estás en la wifi del evento. Reintentando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vérifiez que vous êtes sur le Wi-Fi de l'événement. Nouvelle tentative…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć. Upewnij się, że korzystasz z Wi-Fi wydarzenia. Ponawianie…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ligar. Confirme que está ligado à rede Wi-Fi do evento. A tentar novamente…"
          }
        }
      }
    },
