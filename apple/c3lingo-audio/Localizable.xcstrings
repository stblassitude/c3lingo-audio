    "Leave empty to use %@. Currently using %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um %1$@ zu verwenden. Derzeit wird %2$@ verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar %1$@. Ahora se usa %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser %1$@. Actuellement : %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby użyć %1$@. Obecnie używany: %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para usar %1$@. Atualmente a usar %2$@."
          }
        }
      }
    },
