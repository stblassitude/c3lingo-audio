# Lanes for App Store Connect. See "Releasing the Apple app" and "Screenshots" in
# README.md.
#
# Both use the App Store Connect API key from APP_STORE_CONNECT_KEY_ID,
# APP_STORE_CONNECT_ISSUER_ID and APP_STORE_CONNECT_KEY_PATH (the .p8 file).

require "open3"

APP_IDENTIFIER = "org.c3lingo.audio"

REPOSITORY = File.expand_path("../..", __dir__)

# Absolute, as actions run in apple/, not in fastlane/ like the lanes.
METADATA_PATH = File.expand_path("metadata", __dir__)

# The Android app's version is the one for both apps.
GRADLE = File.join(REPOSITORY, "android", "app", "build.gradle.kts")

# The release notes for all platforms, in release_notes/<version code>/<Google Play
# locale>.txt, as ./release puts them, and the script that picks each platform's items.
RELEASE_NOTES = File.expand_path("release_notes", __dir__)
FILTER = File.join(REPOSITORY, "shared", "filter-release-notes")

# App Store Connect locale and Google Play's, where they differ.
PLAY_LOCALES = { "pl" => "pl-PL" }.freeze

# App Store Connect platform and the filter's name for it.
FILTER_PLATFORMS = {
  "ios" => "ios",
  "xros" => "visionos",
  "osx" => "macos"
}.freeze

# App Store Connect platform and the folder in screenshots/ with its screenshots.
PLATFORMS = {
  "ios" => "ios",
  "xros" => "visionos",
  "osx" => "macos"
}.freeze

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
  )
end

# App Review's contact, which App Store Connect requires with the notes. From
# APP_REVIEW_FIRST_NAME, APP_REVIEW_LAST_NAME, APP_REVIEW_EMAIL and APP_REVIEW_PHONE
# (`+` and the country code), not from metadata/review_information/, as the repository is
# public. The notes come from metadata/review_information/notes.txt.
def app_review_contact
  {
    first_name: ENV.fetch("APP_REVIEW_FIRST_NAME", nil),
    last_name: ENV.fetch("APP_REVIEW_LAST_NAME", nil),
    email_address: ENV.fetch("APP_REVIEW_EMAIL", nil),
    phone_number: ENV.fetch("APP_REVIEW_PHONE", nil)
  }.reject { |_, value| value.to_s.strip.empty? }
end

def gradle_value(name)
  File.read(GRADLE)[/^ *#{name} = "?([^"\n]*)"?$/, 1] || UI.user_error!("No #{name} in #{GRADLE}")
end

# Uploads the texts in metadata/<locale>/ (name, subtitle, description, keywords) to the
# version being prepared in App Store Connect, creating it if needed, with the release
# notes for that platform from release_notes/<version code>/. Languages without release
# notes get the English ones. Called by .github/workflows/apple-testflight.yml.
#
#   bundle exec fastlane upload_metadata [platforms:ios,osx,xros]
lane :upload_metadata do |options|
  version = gradle_value("versionName")
  code = gradle_value("versionCode")
  notes = lambda do |locale, platform|
    path = File.join(RELEASE_NOTES, code, "#{PLAY_LOCALES.fetch(locale, locale)}.txt")
    next nil unless File.exist?(path)
    text, status = Open3.capture2(FILTER, FILTER_PLATFORMS.fetch(platform), stdin_data: File.read(path))
    UI.user_error!("#{FILTER} failed for #{path}") unless status.success?
    text
  end
  # The language folders, not review_information/.
  locales = Dir.glob("*/name.txt", base: METADATA_PATH).map { |path| File.dirname(path) }.sort

  key = api_key
  (options[:platforms]&.split(",") || ["ios"]).each do |platform|
    english = notes.call("en-US", platform) || UI.user_error!("No release notes in #{RELEASE_NOTES}/#{code}/en-US.txt")
    release_notes = locales.to_h { |locale| [locale, notes.call(locale, platform) || english] }
    UI.header("Uploading #{platform} metadata for #{version}")
    deliver(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      platform: platform,
      app_version: version,
      metadata_path: METADATA_PATH,
      release_notes: release_notes,
      app_review_information: app_review_contact,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      # No HTML preview to confirm.
      force: true
    )
  end
end

# Uploads the screenshots taken by apple/screenshots/capture.sh to the version of the
# app that is being prepared in App Store Connect. See "Screenshots" in README.md.
#
#   bundle exec fastlane upload_screenshots
lane :upload_screenshots do |options|
  key = api_key
  # Only the platforms named, e.g. `platforms:ios,osx`, or all that have screenshots.
  wanted = options[:platforms]&.split(",") || PLATFORMS.keys
  PLATFORMS.slice(*wanted).each do |platform, folder|
    path = File.expand_path(File.join("screenshots", folder), __dir__)
    if Dir.glob(File.join(path, "*", "*.png")).empty?
      UI.important("No screenshots in #{path}, skipping #{platform}")
      next
    end
    UI.header("Uploading #{folder} screenshots")
    deliver(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      platform: platform,
      screenshots_path: path,
      # Replaces all screenshots of the languages in the folder.
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      # No HTML preview to confirm: this runs after looking at the files.
      force: true
    )
  end
end
