#!/bin/bash
# Releases both apps: takes the release notes from release-notes/ and splits them for
# Android and the Apple apps, sets the Android version, commits, tags v<version> and
# pushes. The tag starts the release workflows.
# See "Releasing" in README.md.
#
#   ./release 1.2.0        asks before pushing
#   ./release -y 1.2.0     doesn't ask
set -euo pipefail

cd "$(dirname "$0")"

yes=
if [ "${1:-}" = -y ]; then
    yes=1
    shift
fi
if [ $# -ne 1 ] || ! [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "usage: $0 [-y] <major.minor.patch>" >&2
    exit 2
fi
version=$1
tag=v$version

gradle=android/app/build.gradle.kts
metadata=fastlane/metadata/android
apple_notes=apple/fastlane/release_notes
notes=release-notes
filter=shared/filter-release-notes

fail() {
    echo "$0: $*" >&2
    exit 1
}

# Release notes are counted in characters, not bytes.
export LC_ALL=en_US.UTF-8

# Only from an up-to-date main without local changes, so the tag is what's on GitHub.
[ "$(git branch --show-current)" = main ] || fail "not on main"
[ -z "$(git status --porcelain)" ] || fail "uncommitted changes"
git fetch --quiet origin main --tags
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "main differs from origin/main"
! git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null || fail "$tag exists already"

# A reminder to retake the screenshots when an app changed since the last release but its
# screenshots didn't. The Android ones are committed; the Apple ones aren't, so their
# files' times are compared with the last release's.
last=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || true)
if [ -n "$last" ]; then
    stale=()
    if [ -n "$(git diff --name-only "$last" -- android/app/src/main shared)" ] \
        && [ -z "$(git diff --name-only "$last" -- 'fastlane/metadata/android/*/images/*')" ]; then
        stale+=("Android (android/screenshots/capture.sh, then commit them)")
    fi
    if [ -n "$(git diff --name-only "$last" -- apple/c3lingo-audio shared)" ]; then
        released=$(git log -1 --format=%ct "$last")
        newest=$(find apple/fastlane/screenshots -type f -name '*.png' -exec stat -f %m {} + 2>/dev/null \
            | sort -n | tail -1)
        if [ -z "$newest" ] || [ "$newest" -lt "$released" ]; then
            stale+=("Apple (apple/screenshots/capture.sh, then fastlane upload_screenshots)")
        fi
    fi
    if [ ${#stale[@]} -gt 0 ]; then
        echo "The apps changed since $last, but these screenshots didn't:"
        printf '  %s\n' "${stale[@]}"
        if [ -z "$yes" ]; then
            read -r -p "Release anyway? [y/N] " answer
            [ "$answer" = y ] || exit 1
        fi
    fi
fi

old_name=$(sed -n 's/^ *versionName = "\(.*\)"$/\1/p' "$gradle")
old_code=$(sed -n 's/^ *versionCode = \([0-9]*\)$/\1/p' "$gradle")
[ -n "$old_name" ] && [ -n "$old_code" ] || fail "no versionName or versionCode in $gradle"
[ "$(printf '%s\n' "$old_name" "$version" | sort -V | tail -1)" = "$version" ] \
    && [ "$old_name" != "$version" ] || fail "$version isn't after $old_name"
code=$((old_code + 1))

# One file per language, named like the folders in fastlane/metadata/android/,
# with items for single platforms marked as $filter describes.
[ -s "$notes/en-US.txt" ] || fail "write the release notes into $notes/en-US.txt first"
for file in "$notes"/*.txt; do
    locale=$(basename "$file" .txt)
    [ -d "$metadata/$locale" ] || fail "$file: no language $locale in $metadata"
    for platform in android ios macos visionos; do
        text=$("$filter" "$platform" < "$file")
        [ -n "$(tr -d '[:space:]' <<< "$text")" ] || fail "$file: nothing left for $platform"
    done
    # Google Play's and F-Droid's limit.
    length=$("$filter" android < "$file" | wc -m | tr -d ' ')
    [ "$length" -le 500 ] || fail "$file: $length characters for Android, at most 500"
    # App Review rejects notes that name other platforms.
    for platform in ios macos visionos; do
        if "$filter" "$platform" < "$file" | grep -qiE 'android|google|f-droid'; then
            fail "$file: the notes for $platform mention Android; mark the item with \"Android:\""
        fi
    done
done

echo "versionName $old_name -> $version"
echo "versionCode $old_code -> $code"
sed -i.bak \
    -e "s/^\( *versionName = \)\".*\"$/\1\"$version\"/" \
    -e "s/^\( *versionCode = \)[0-9]*$/\1$code/" \
    "$gradle"
rm "$gradle.bak"
# Android's for Google Play and F-Droid, under each one's version codes; all of them for
# the Apple apps, which the App Store lane filters for each platform.
mkdir -p "$apple_notes/$code"
for file in "$notes"/*.txt; do
    locale=$(basename "$file" .txt)
    mkdir -p "$metadata/$locale/changelogs"
    "$filter" android < "$file" > "$metadata/$locale/changelogs/$code.txt"
    git add "$metadata/$locale/changelogs/$code.txt"
    # F-Droid's version codes, one per ABI, see android/app/build.gradle.kts.
    for abi in 1 2 4; do
        cp "$metadata/$locale/changelogs/$code.txt" "$metadata/$locale/changelogs/$code$abi.txt"
        git add "$metadata/$locale/changelogs/$code$abi.txt"
    done
    git mv "$file" "$apple_notes/$code/$locale.txt"
    echo "release notes: $metadata/$locale/changelogs/$code.txt, $apple_notes/$code/$locale.txt"
done

git add "$gradle"
git commit --quiet -m "Release $version"
git tag -a "$tag" -F "$apple_notes/$code/en-US.txt"
git log --oneline -1

if [ -z "$yes" ]; then
    read -r -p "Push main and $tag to origin? [y/N] " answer
    if [ "$answer" != y ]; then
        echo "Not pushed. To undo: git tag -d $tag && git reset --hard HEAD^"
        exit 1
    fi
fi
git push --atomic origin main "$tag"
